# Cowork writes files with LF; keep them LF in the working tree on Windows too, so git stops
# warning "LF will be replaced by CRLF" and diffs stay clean across the Linux/Windows boundary.
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
# The web sources were left out of the original list, which is about half the repo's text: 51
# files, five of them CRLF on disk. Windows git normalises on read so the tree looked clean here,
# while a Linux shell saw a 479-line phantom diff of pure line-ending churn - and the first stage
# to touch one of those files from Linux would have committed that churn into every future blame.
*.js    text eol=lf
*.mjs   text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
# RECORDED FETCHES ARE BYTES, and are asserted as bytes. tests/fixtures/*.html and *.json hold pages
# and payloads exactly as a source served them, and their tests pin a sha256 and a byte count so a
# silent site change fails a test rather than quietly changing what gets loaded. Line-ending
# normalisation would rewrite those bytes on checkout and break the assertion on any machine but the
# one that recorded them - so these are excluded from it. `-text` is not "binary": git still stores
# and diffs them as files, it simply does not touch their line endings.
tests/fixtures/*.html  -text
tests/fixtures/*.json  -text
