{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(npm run test:unit *)",
      "Bash(npm run smoke *)",
      "Bash(npm run geometry *)",
      "Bash(node scripts/qa-shots.mjs *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push *+*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add * -A*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(psql*)",
      "Bash(python -m pipeline.load*)",
      "Bash(python -m pipeline.standings*)",
      "Bash(python -m pipeline.enrich_cfb*)",
      "Bash(python3 -m pipeline.load*)",
      "Bash(python3 -m pipeline.standings*)",
      "Bash(python3 -m pipeline.enrich_cfb*)",
      "Bash(py -m pipeline.load*)",
      "Bash(py -m pipeline.standings*)",
      "Bash(py -m pipeline.enrich_cfb*)",
      "Bash(python pipeline/load*)",
      "Bash(python pipeline/standings*)",
      "Bash(python pipeline/enrich_cfb*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push *-f)",
      "PowerShell(git push *-f *)",
      "PowerShell(git push *+*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git reset * --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git rebase*)",
      "PowerShell(git filter-branch*)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch * -D *)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git add .)",
      "PowerShell(psql*)",
      "PowerShell(python -m pipeline.load*)",
      "PowerShell(python -m pipeline.standings*)",
      "PowerShell(python -m pipeline.enrich_cfb*)",
      "PowerShell(py -m pipeline.load*)",
      "PowerShell(py -m pipeline.standings*)",
      "PowerShell(py -m pipeline.enrich_cfb*)",
      "Read(./.env)"
    ]
  }
}
