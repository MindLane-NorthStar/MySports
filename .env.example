SUPABASE_DB_URL=postgresql://mysports_writer.ztnppejmdwmhqstqsfks:<PASSWORD>@<SESSION-POOLER-HOST>:5432/postgres?sslmode=require
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
