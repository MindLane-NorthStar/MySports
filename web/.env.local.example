# MySports web app - anon (read-only) Supabase REST access.
#
# Both values below are PUBLISHABLE. The anon key is a signed JWT whose only claim is role=anon;
# every table it can reach is reachable because an RLS policy grants anon SELECT on it. It carries no
# write capability and no secret. It is committed here, and as the default in lib/config.js, on purpose:
# the app must build and run on a clean checkout with no secret provisioning.
#
# The writer DSN (SUPABASE_DB_URL) and the R2 keys live in the repo-root .env and never come near this app.

NEXT_PUBLIC_SUPABASE_URL=https://ztnppejmdwmhqstqsfks.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp0bnBwZWptZHdtaHFzdHFzZmtzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU3NDgzMDIsImV4cCI6MjA5MTMyNDMwMn0._CrGovWte9r1wNfW0jN01AFHa9p1GVe9BKAgZqK-POY

# Postgres schema exposed through PostgREST (sent as the Accept-Profile header).
NEXT_PUBLIC_SUPABASE_SCHEMA=mysports

# Public R2 base for logos/, network-logos/ and grids/.
NEXT_PUBLIC_ASSET_BASE_URL=https://pub-8373112ac08548d8af79fe58b7c2dcb9.r2.dev/
